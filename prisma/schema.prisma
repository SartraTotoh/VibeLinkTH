generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Plan {
  FREE
  CREATOR
  CREATOR_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum EventType {
  CLICK
  VIEW
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TicketStatus {
  OPEN
  RESOLVED
}

enum SupportSender {
  MEMBER
  ADMIN
  AUTO
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  displayName   String?
  emailVerified   DateTime?
  termsAcceptedAt DateTime?
  plan          Plan           @default(FREE)
  vibeSlug      String?        @unique
  vibeTitle     String?
  vibeBio       String?
  vibeEmoji     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  links         Link[]
  campaigns     Campaign[]
  events        LinkEvent[]
  subscription  Subscription?
  accounts      Account[]
  sessions      Session[]
  emailTokens   EmailToken[]
  supportTickets SupportTicket[]
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  tokenHash String            @unique
  purpose   EmailTokenPurpose
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Link {
  id            String      @id @default(cuid())
  userId        String
  title         String
  slug          String      @unique
  destinationUrl String
  platform      String?
  status        LinkStatus  @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        LinkEvent[]
  campaigns     Campaign[]

  @@index([userId, status])
}

model Campaign {
  id          String      @id @default(cuid())
  userId      String
  linkId      String?
  name        String
  source      String
  medium      String
  content     String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link?       @relation(fields: [linkId], references: [id], onDelete: SetNull)
  events      LinkEvent[]

  @@index([userId, createdAt])
}

model LinkEvent {
  id          String    @id @default(cuid())
  type        EventType @default(CLICK)
  userId      String
  linkId      String
  campaignId  String?
  device      String?
  browser     String?
  os          String?
  country     String?
  referrer    String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([linkId, createdAt])
  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  plan        Plan
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  expiresAt   DateTime?
  providerRef String?
  customerRef String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  action      String
  subjectType String
  subjectRef  String?
  detail      String?
  result      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AutoReplyRule {
  id         String   @id @default(cuid())
  enabled    Boolean  @default(true)
  priority   Int      @default(100)
  keywords   String
  replyTh    String
  replyEn    String
  faqTh      String?
  faqEn      String?
  category   String   @default("general")
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled, priority])
}

model SupportSettings {
  id            String   @id @default("singleton")
  autoReplyOn   Boolean  @default(true)
  faqOn         Boolean  @default(true)
  greetingTh    String
  greetingEn    String
  noMatchTh     String
  noMatchEn     String
  hoursTh       String?
  hoursEn       String?
  emailNotify   Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model SupportTicket {
  id             String           @id @default(cuid())
  userId         String
  status         TicketStatus     @default(OPEN)
  needsAdmin     Boolean          @default(true)
  subjectPreview String?
  lastMessageAt  DateTime         @default(now())
  lastSender     SupportSender    @default(MEMBER)
  adminSeenAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       SupportMessage[]

  @@index([status, needsAdmin, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  sender    SupportSender
  body      String
  ruleId    String?
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
