generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum Plan {
  FREE
  CREATOR
  CREATOR_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum EventType {
  CLICK
  VIEW
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  displayName   String?
  emailVerified   DateTime?
  termsAcceptedAt DateTime?
  plan          Plan           @default(FREE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  links         Link[]
  campaigns     Campaign[]
  events        LinkEvent[]
  subscription  Subscription?
  accounts      Account[]
  sessions      Session[]
  emailTokens   EmailToken[]
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  tokenHash String            @unique
  purpose   EmailTokenPurpose
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Link {
  id            String      @id @default(cuid())
  userId        String
  title         String
  slug          String      @unique
  destinationUrl String
  platform      String?
  status        LinkStatus  @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        LinkEvent[]
  campaigns     Campaign[]

  @@index([userId, status])
}

model Campaign {
  id          String      @id @default(cuid())
  userId      String
  linkId      String?
  name        String
  source      String
  medium      String
  content     String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link?       @relation(fields: [linkId], references: [id], onDelete: SetNull)
  events      LinkEvent[]

  @@index([userId, createdAt])
}

model LinkEvent {
  id          String    @id @default(cuid())
  type        EventType @default(CLICK)
  userId      String
  linkId      String
  campaignId  String?
  device      String?
  browser     String?
  os          String?
  country     String?
  referrer    String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([linkId, createdAt])
  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @unique
  plan        Plan
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  expiresAt   DateTime?
  providerRef String?
  customerRef String?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  action      String
  subjectType String
  subjectRef  String?
  detail      String?
  result      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
