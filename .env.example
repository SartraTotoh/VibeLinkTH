DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vibelink?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/vibelink?schema=public"
APP_URL="http://localhost:3000"
SHORT_LINK_URL="http://localhost:3000/go"
AUTH_SECRET="generate-with-node-e-console-log-require-crypto-randomBytes-32-toString-base64"
AUTH_TRUST_HOST="true"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_CREATOR="price_xxx"
STRIPE_PRICE_CREATOR_PLUS=""

# Transactional email (Resend). Leave RESEND_API_KEY empty to log emails to console (dev).
RESEND_API_KEY=""
EMAIL_FROM="VibeLink <no-reply@vibelinkth.com>"
EMAIL_REPLY_TO="hello@vibelinkth.com"

# Set to "true" to block login until email is verified.
REQUIRE_EMAIL_VERIFICATION="false"

# Public site url of the app (used for canonical/OG links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Legal / company info shown on Terms & Privacy pages
COMPANY_NAME="VibeLink"
COMPANY_ADDRESS="กรุงเทพมหานคร ประเทศไทย"
COMPANY_CONTACT_EMAIL="hello@vibelinkth.com"

# Comma-separated emails allowed to open /dev (admin console)
ADMIN_EMAILS=""

# SHA-256 hex of the 6-digit admin export PIN (never store the raw PIN).
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('123456').digest('hex'))"
ADMIN_EXPORT_PIN_HASH=""

# Pitch Studio is a public draft tool. Keep server email delivery off by default.
# If enabled, delivery still requires an authenticated admin, same-origin JSON,
# one recipient, explicit recipient confirmation, an idempotency UUID and DB quotas.
PITCH_EMAIL_ENABLED="false"

# Live alpha: local rehearsal works with all flags off.
# Apply prisma/live-schema.sql (including its partial unique index) before schema-ready.
LIVE_SCHEMA_READY="false"
LIVE_TRANSPORT_ENABLED="false"
# Set true only after the signed provider webhook and a once/minute POST /api/cron/live watchdog work.
LIVE_WATCHDOG_READY="false"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Exact approved RTMP(S) ingest hosts, comma separated; no wildcards or IP addresses.
LIVE_RTMP_HOSTS=""
CRON_SECRET=""
