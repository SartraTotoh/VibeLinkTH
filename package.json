{
  "name": "vibelink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:charset": "node scripts/check-charset.mjs",
    "check:branding": "node scripts/sync-product-branding.mjs --check",
    "sync:branding": "node scripts/sync-product-branding.mjs",
    "brand:og": "node scripts/generate-brand-og.mjs",
    "check:security": "node scripts/check-security.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/patch-opennext-prisma.mjs && node scripts/patch-opennext-middleware.mjs",
    "cf:deploy": "npm run check:charset && npm run check:security && npm run cf:build && wrangler deploy",
    "test:unit": "vitest run",
    "test:e2e": "playwright test e2e/public-smoke.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse:app": "npx -y lighthouse https://app.vibelinkth.com --preset=desktop --quiet --chrome-flags=--headless"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.13",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.4",
    "pngjs": "^5.0.0",
    "prisma": "^6.16.2",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  },
  "overrides": {
    "postcss": "^8.5.28",
    "source-map-js": "^1.2.2",
    "deepmerge-ts": "^8.0.0"
  }
}
