{
  "name": "vibelink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "cf:build": "opennextjs-cloudflare build && node scripts/patch-opennext-prisma.mjs",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "test:unit": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse:app": "npx -y lighthouse https://app.vibelinkth.com --preset=desktop --quiet --chrome-flags=--headless"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^22.6.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.1",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  }
}
